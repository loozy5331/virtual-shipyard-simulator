{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/loozy5331/virtual-shipyard-simulator/schemas/payloads/order.contracted.json",
  "title": "order.contracted payload",
  "type": "object",
  "properties": {
    "ship_type": {
      "enum": [
        "lng_carrier",
        "vlcc",
        "container"
      ],
      "description": "선종"
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "description": "가상 선주사"
    },
    "contract_delivery_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "계약 납기"
    },
    "block_count": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "ship_type",
    "owner",
    "contract_delivery_date",
    "block_count"
  ],
  "additionalProperties": false
}
